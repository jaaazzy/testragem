# Copy to a PRIVATE .env file. Never commit filled values.
DB_PASSWORD=replace-with-a-long-random-password
SPRING_PROFILES_ACTIVE=local
AUTH_PUBLIC_URL=http://localhost:8088
SITE_ADDRESS=:80
HTTP_PORT=8088
HTTPS_PORT=8443
DATASET_DIRECTORY=./data
# Leave empty until you place an OHLCV file in DATASET_DIRECTORY.
BACKTEST_DATASET_CSV=
BACKTEST_DATASET_SOURCE=Operator-provided historical CSV
SPRING_MAIL_HOST=
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
MAIL_FROM=
